# Anthropic (campaign generator)
ANTHROPIC_API_KEY=

# Supabase — read-side. Must match the portal's project. The cookie itself is
# set by the portal at ivm-agents.com and shared via the cookie domain below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cookie domain
# Leave UNSET in local dev (cross-port cookies don't share anyway — see README).
# Set to `.ivm-agents.com` in production so the portal's auth cookie is
# readable on this subdomain.
NEXT_PUBLIC_COOKIE_DOMAIN=

# Portal URL — used for unauthenticated redirects, the "Back to Portal" link,
# and the post-logout landing.
# Local: http://localhost:3000  ·  Prod: https://ivm-agents.com
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000

# Higgsfield AI (asset generation — image + video)
HIGGSFIELD_API_KEY=
HIGGSFIELD_SECRET=